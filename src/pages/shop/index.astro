---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
---
<BaseLayout
  title="Shop — Small-Batch Essentials from Austin | STAK"
  description="Shop STAK — small-batch essentials from Austin. Drop 002 Barton Skyline Tee, Drop 001 garment dyed tee, and washed dad hat. Short run and done."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Shop', path: '/shop' },
  ]}
>
  <main>
    <section class="page-hero">
      <p class="eyebrow">Shop</p>
      <h1 class="display">The Shop.</h1>
      <p class="page-hero-sub">
        Small-batch essentials. Short run, and done. Made in Austin — when they're gone, they're gone.
      </p>
    </section>

    <section class="drop" style="padding-top: 0;">
      <div class="products" style="padding-bottom: 140px;">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </section>
  </main>
</BaseLayout>
