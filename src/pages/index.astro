---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getFeaturedProduct } from "../data/products";

const featured = getFeaturedProduct();
---
<BaseLayout
  title="STAK — Austin Apparel | Drop 002 Barton Skyline"
  description="Drop 002 is live. Barton Skyline — navy fine-line ink on an ivory Comfort Colors tee. 30 made. Short run and done."
>
<main id="top">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <img
        src="/products/barton-skyline.jpg"
        srcset="/products/barton-skyline.jpg 1536w"
        sizes="100vw"
        alt="STAK Barton Skyline Tee — navy fine-line illustration of the Austin skyline on an ivory Comfort Colors tee"
        class="hero-image"
        width="1536"
        height="1024"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-overlay hero-overlay-product"></div>
    </div>

    <div class="hero-content">
      <p class="eyebrow fade-in">drop 002 — austin, texas</p>
      <h1 class="hero-title fade-in" style="--delay:.1s">
        Barton<br/>Skyline.
      </h1>
      <p class="hero-sub fade-in" style="--delay:.2s">
        navy fine-line ink on an ivory Comfort Colors tee.<br/>
        30 made.
      </p>
      <div class="hero-cta fade-in" style="--delay:.3s">
        <a href="/shop/barton-skyline" class="btn btn-primary">shop barton skyline</a>
        <a href="/story" class="btn btn-ghost">Our Story →</a>
      </div>
    </div>

    <div class="hero-meta">
      <div><span class="meta-label">No.</span><span class="meta-value">002</span></div>
      <div><span class="meta-label">Made</span><span class="meta-value">30</span></div>
      <div><span class="meta-label">Est.</span><span class="meta-value">2026</span></div>
    </div>

    <a href="#story" class="scroll-indicator" aria-label="Scroll">
      <span>Scroll</span>
      <span class="scroll-line"></span>
    </a>
  </section>

  <!-- MARQUEE STRIP -->
  <section class="strip">
    <div class="strip-track">
      <span>Limited Runs</span><span class="dot">✦</span>
      <span>Real Places</span><span class="dot">✦</span>
      <span>Made to Last</span><span class="dot">✦</span>
      <span>Austin, TX</span><span class="dot">✦</span>
      <span>Limited Runs</span><span class="dot">✦</span>
      <span>Real Places</span><span class="dot">✦</span>
      <span>Made to Last</span><span class="dot">✦</span>
      <span>Austin, TX</span><span class="dot">✦</span>
      <span>Limited Runs</span><span class="dot">✦</span>
      <span>Real Places</span><span class="dot">✦</span>
      <span>Made to Last</span><span class="dot">✦</span>
      <span>Austin, TX</span><span class="dot">✦</span>
    </div>
  </section>

  <!-- STORY -->
  <section class="story home-story" id="story">
    <div class="story-grid">
      <div class="story-image">
        <div class="story-art">
          <img
            src="/story-in-between.jpg"
            alt="Glowing tent under the Milky Way at night"
            class="story-photo"
            width="1524"
            height="2048"
            loading="lazy"
            decoding="async"
          />
          <div class="story-art-label">
            <span>Austin → Malibu</span>
            <span>1,476 mi</span>
          </div>
        </div>
      </div>

      <div class="story-text">
        <p class="eyebrow">Chapter One</p>
        <h2 class="display">
          Built for the<br/>
          <em>in-between.</em>
        </h2>
        <p class="lede">
          The morning meeting and the desert detour. The city block and the canyon road. STAK is for the day that keeps shifting on you.
        </p>
        <p>
          We make small runs of essentials in Austin, Texas — built from heavyweight cottons, garment-dyed for character, and finished with details that hold up after the hundredth wash. No seasonal noise. No trend chasing. Just pieces you'll reach for first.
        </p>
        <a href="/story" class="link-underline">Read the full story →</a>
      </div>
    </div>
  </section>

  <div class="section-break" aria-hidden="true"></div>

  <!-- SHOP -->
  <section class="drop home-shop" id="drop">
    <div class="drop-header">
      <div>
        <p class="eyebrow">drop 002</p>
        <h2 class="display">Barton Skyline.</h2>
      </div>
      <div class="drop-blurb-wrap">
        <p class="drop-blurb">
          navy fine-line ink on an ivory Comfort Colors tee. 30 made. short run and done.
        </p>
        <p class="drop-blurb">
          a short run means every shirt gets more than inspected. it gets held up. turned over. tried on by someone in the room before it goes in the bag.
        </p>
        <a href="/shop" class="link-underline">the rest of the shop →</a>
      </div>
    </div>
    <div class="products products-featured" id="shop">
      <ProductCard product={featured} />
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="home-cta">
    <a href="/shop/barton-skyline" class="home-cta-link">shop barton skyline →</a>
  </section>
</main>
</BaseLayout>
